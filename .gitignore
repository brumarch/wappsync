# Dados locais: sessão do WhatsApp e banco de mensagens. NUNCA versionar.
/data/
*.db
*.db-shm
*.db-wal

# Configuração real (contém caminhos/remotes pessoais)
config.toml

# Saídas de export
/out/
*.jsonl
*.jsonl.gz

# ...mas fixtures e goldens de teste TÊM que ser versionados.
# Esta negação precisa vir depois dos padrões acima.
!**/testdata/**

# Binários (inclui os .exe~ que o linker do Go deixa no Windows)
/wappsync
/wappsync.exe
wappsync.exe~
*.exe
*.exe~
/bin/
